{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "globalSetup": "./helper/setup.ts",
  "globalTeardown": "./helper/teardown.ts",
  "maxWorkers": 4,
  "clearMocks": true
}
