{
  "name": "div",
  "version": "0.0.1",
  "description": "Awesome project developed with TypeORM.",
  "type": "module",
  "dependencies": {
    "@faker-js/faker": "^10.1.0",
    "@types/express": "^5.0.6",
    "body-parser": "^2.2.1",
    "express": "^5.2.1",
    "pg": "^8.16.3",
    "ts-node": "^10.9.2",
    "typeorm": "^0.3.28",
    "typeorm-extension": "^3.7.3",
    "typeorm-ts-node-esm": "^0.3.20"
  },
  "scripts": {
    "dev": "nodemon",
    "build": "rimraf build && concurrently \"tsc\"",
    "start": "npm run build && nodemon build/index.js",
    "typeorm": "typeorm-ts-node-esm",
    "seed:run": "ts-node ./node_modules/typeorm-extension/bin/cli.cjs seed:run",
    "seed:create": "ts-node ./node_modules/typeorm-extension/bin/cli.cjs seed:create"
  },
  "devDependencies": {
    "@types/node": "^25.0.2",
    "concurrently": "^9.2.1",
    "nodemon": "^3.1.11",
    "rimraf": "^6.1.2",
    "typescript": "^5.9.3"
  }
}
